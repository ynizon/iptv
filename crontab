# Every night: the playlists first (new, moved and removed titles), then TMDB for the new titles
0 2 * * * cd /var/www && /usr/local/bin/php artisan refresh:playlist >> /var/log/cron.log 2>&1; /usr/local/bin/php artisan refresh:info >> /var/log/cron.log 2>&1
# Every Sunday: keep only the end of the log
0 1 * * 0 tail -n 5000 /var/log/cron.log > /var/log/cron.log.tmp && mv /var/log/cron.log.tmp /var/log/cron.log

